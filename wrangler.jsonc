{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-experiments",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-14",

	"account_id": "78b2f97010ad03429a7320b53cbd01a9", // TigersWay

	"env": {
		// Potential "battle grounds"
		"theo-courant": {
			"account_id": "f8ec61612b82388e5a81fd1813aed08e"
		},
		"esytravel": {
			"account_id": "0fe421af6cb662aa3328d9632024d704"
		}
	},

	"assets": {
		"directory": "./public",
		"not_found_handling": "404-page",
		"run_worker_first": ["/worker"]
	},

	"observability": {
		"logs": { "enabled": true, "invocation_logs": true },
		"traces": { "enabled": true }
	},

	"placement": { "mode": "smart" }
