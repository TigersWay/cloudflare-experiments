{
	"name": "cloudflare-experiments",
	"description": "Cloudflare Workers experiments",
	"keywords": [
		"cloudflare",
		"cloudflare-workers",
		"itty-router",
		"vite",
		"svelte5"
	],
	"version": "0.0.0",
	"license": "MIT",
	"author": "Ben Michaud <ben@tigersway.net>",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"prebuild": "rimraf --glob \"public/!(.gitkeep)\"",
		"wrangler": "vite build && wrangler dev",
		"deploy": "vite build && wrangler deploy --env=''",
		"test": "vitest run"
	},
	"devDependencies": {
