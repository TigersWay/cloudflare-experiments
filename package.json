		"@tailwindcss/vite": "^4.3.3",
		"cn": "^0.3.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rimraf": "^6.1.3",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"vite-plugin-ejs": "^2.0.0",
		"vite-plugin-minify": "^3.0.0",
		"vitest": "^4.1.11",
